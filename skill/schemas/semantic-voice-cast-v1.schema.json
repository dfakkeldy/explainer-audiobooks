{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dfakkeldy/explainer-audiobooks/blob/main/skill/schemas/semantic-voice-cast-v1.schema.json",
  "title": "Semantic voice cast v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "narrationMode",
    "source",
    "defaultRoleID",
    "roles",
    "groups",
    "authoredVoicePlan",
    "singleVoiceWaiver"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "narrationMode": {"const": "semantic-block"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epubFileName", "epubSHA256", "inventoryFileName", "inventorySHA256"],
      "properties": {
        "epubFileName": {"type": "string", "pattern": "^[^/\\\\\u0000\\r\\n]+$"},
        "epubSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inventoryFileName": {"type": "string", "pattern": "^[^/\\\\\u0000\\r\\n]+$"},
        "inventorySHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "defaultRoleID": {"const": "guide"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roleID", "voiceID"],
        "properties": {
          "roleID": {"enum": ["guide", "memory", "field", "coach"]},
          "voiceID": {"type": "string", "pattern": "^[a-z]+_[a-z]+$"}
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["groupID", "roleID", "blocks"],
        "properties": {
          "groupID": {"type": "string", "pattern": "^(memory|field|coach)-[0-9]{3}$"},
          "roleID": {"enum": ["memory", "field", "coach"]},
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string", "pattern": "^s[0-9]+-b[0-9]+$"}
          }
        }
      }
    },
    "authoredVoicePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256"],
      "properties": {
        "fileName": {"type": "string", "pattern": "^[^/\\\\\u0000\\r\\n]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "singleVoiceWaiver": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["recordedIn", "reason"],
          "properties": {
            "recordedIn": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
